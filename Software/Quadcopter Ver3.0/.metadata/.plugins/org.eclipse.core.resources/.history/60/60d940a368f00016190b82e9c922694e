// ----- Init Timer 1 -----
// Timer one is used as timer for system. GetMicros and delays
void init_T1(){
	cli(); //Disable all interrupts

	// Initialize the Overflow counter variable
	T1_overflow_count = 0;

	// Clear Registers
	TCCR1A = 0;
	TCCR1B = 0;

	// TCCR1 - set WGM waveform generation mode
	// Fast PWM
	// TOP = OCR1A
	TCCR1A |= (1 << WGM10);
	TCCR1A |= (1 << WGM11);
	TCCR1B |= (1 << WGM12);
	TCCR1B |= (1 << WGM13);

	// set the prescaler. Clk/8
	TCCR1B |= (1 << CS11); // 0.5us tick

	// TIMSK - enable Output Compare A Match Interrupt
	TIMSK1 |= (1 << OCIE1A);

	// OCR1, Output Compare Register
	OCR1A = 1999; // This is to give an interrupt every 1ms 0 - 1999 = 2000 ticks. 2000ticks * 0.5us = 1ms

	sei(); // Enable all Interrupts
}

// ----- Ticks 0.5us resoloution ----
uint32_t ticks_T1(){
	cli(); //Clear interrupts
	uint16_t local_TCNT1 = TCNT1;
	uint8_t local_TIFR = bitRead(TIFR2,1);

	if(local_TIFR){
		local_TCNT1 = TCNT1;
		T1_overflow_count++;
		TIFR1 |= (1 << OCFA);
	}
	uint32_t ticks = local_TCNT1 + (T1_overflow_count * 2000); // Returns the number of ticks.
	sei(); // Set interrupts
	return ticks;
}

uint32_t micros_T1(){
	return ticks_T1() * 0.5;
}


// ----- Delay Milli Second -----
// NOTE: Not very accurate due to checking count and not isr
// Useful for debug
void delay_T1(int ms){
	// Initial value
	uint32_t start = T1_overflow_count;

	// Do While True
	while (T1_overflow_count < (start+ms)){}
}

// Set up Pins for PinChange i.e. PWM Read
void init_PWMREAD(){
	// Clear interrupts
	cli();

	// Enable Pin Change Interrupt 0 [7:0]
	PCICR |= (0 << PCIE0);
	PCICR |= (0 << PCIE1);
	PCICR |= (1 << PCIE2);

	// Enable pin D2 (PCINT2) for interrupts
	PCMSK2 = 0;
	PCMSK2 |= (1 << PCINT18);

	PCMSK0 = 0;
	PCMSK1 = 0;

	// Enable Interrupts
	sei();
}
// ----- SETUP -----
void setup() {

	SREG |= (1 << 7);
	init_T1();

	Serial.begin(115200);
	pinMode(13, OUTPUT);
	pinMode(2, INPUT);

	init_PWMREAD();

	PORTB = PORTB & B11011111; //pin 13 LOW
	//PORTB = PORTB | B00100000; //pin 13 HIGH
}

