// ----- INTERUPT SERVICE ROUTINE -----
// This is called every 1ms
ISR(TIMER1_COMPA_vect){
	//PORTB = PORTB ^ B00100000;
	T1_overflow_count++;
	T1_timer++;
}

ISR(PCINT2_vect){

	//Channel 1: Throttle =========================================
	//Input 2 changed from 0 to 1 (Rising Edge)
	if(last_channel_1 == 0 && (PIND & B00000100) ){
		rising_time = ticks_T1();
		PORTB = PORTB | B00100000; // Set Pin 13 HIGH
		last_channel_1 = 1;        //Remember current input state
		}
	//Input 2 changed from 1 to 0 (Falling Edge)
	else if(last_channel_1 == 1 && !(PIND & B00000100)){
		falling_time = ticks_T1();
		PORTB = PORTB & B11011111; // Set Pin 13 LOW
		last_channel_1 = 0; //Remember current input state
		pulse_width = falling_time - rising_time;
		}
	}


