// ----- Init Timer 1 -----
// Timer one is used as timer for system. GetMicros and delays
void init_T1(){
cli(); //Disable all interrupts
TCCR1A = 0;
TCCR1B = 0;

// TCCR1 - set WGM waveform generation mode
// Fast PWM 8bit PWM
TCCR1A |= (1 << WGM10);
//TCCR1A |= (1 << WGM11);
TCCR1B |= (1 << WGM12);
//TCCR1B |= (1 << WGM13);

// set the prescaler
TCCR1B |= (1 << CS11); // 8 Bit Scaler

// TIMSK - enable overflow interrupt
TIMSK1 |= (1 << TOIE1);

sei(); // Enable all Interrupts
}


uint32_t get_ticks(){
cli();
	uint32_t ticks = TCNT1 + (T1_overflow_count * 65536);
sei();
return ticks;
}


