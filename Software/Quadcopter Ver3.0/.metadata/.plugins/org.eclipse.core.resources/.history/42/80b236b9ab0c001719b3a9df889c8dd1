#include <Arduino.h>
#include "T1.h"
#include "Radio.h"

Radio newRadio;
uint16_t THRO_pulse_width = 0;

void setup() {
newRadio.init_channels();
Serial.begin(115200);
}

void loop() {
Serial.println(THRO_pulse_width);
delay_t1(10);
}


// ----- Interrupts ----- //
// PCINT[7:0]
ISR(PCINT0_vect){

}

// PCINT[14:8]
ISR(PCINT1_vect){

}

// PCINT[16:23]
ISR(PCINT2_vect){
	//Channel 1: Throttle =========================================
	THRO_pulse_width = newRadio.read_thro();
}
