// ----- Init Timer 1 -----
// Timer one is used as timer for system. GetMicros and delays
void init_T1(){
cli(); //Disable all interrupts
TCCR1A = 0;
TCCR1B = 0;

// TCCR1 - set WGM waveform generation mode
// Fast PWM
TCCR1A |= (1 << WGM10);
//TCCR1A |= (1 << WGM11);
TCCR1B |= (1 << WGM12);
//TCCR1B |= (1 << WGM13);

// set the prescaler
TCCR1B |= (1 << CS11); // 8 Bit Scaler

// TIMSK - enable overflow interrupt
TIMSK1 |= (1 << TOIE1);

sei(); // Enable all Interrupts
}

// ----- Delay Micro Second -----
void myDelay(int us){
uint16_t start = TCNT1;
while((TCNT1 - start) < (us*2)) {}
}

// ----- Get Micro Second -----
int myMicro(){

	return TCNT1 * 0.5;
}

uint16_t a,b,c;
void setup() {
  // put your setup code here, to run once:
init_T1();
Serial.begin(115200);
  pinMode(13, OUTPUT);
  PORTB = PORTB & B11011111; //pin 13 low


}

void loop() {

PORTB = PORTB | B00100000; //Pin 13 HIGH
int a = myMicro();

myDelay(1000);

PORTB = PORTB & B11011111; //pin 13 low
int b = myMicro() - a;
Serial.println(b);

	}



