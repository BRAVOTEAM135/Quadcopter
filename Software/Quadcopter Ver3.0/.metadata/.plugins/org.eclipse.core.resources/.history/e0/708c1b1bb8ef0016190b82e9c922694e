	Serial.print(ticks_T1());
	Serial.print("-:-");
	if(T1_timer == 1){
		T1_timer = 0;
		PORTB = PORTB ^ B00100000;
	}
	Serial.println(ticks_T1());
	}


// ----- INTERUPT SERVICE ROUTINE -----
// This is called every 1ms
ISR(TIMER1_COMPA_vect){
	//PORTB = PORTB ^ B00100000;
	T1_overflow_count++;
	T1_timer++;
}


