/* =========================
 * ===== ARDUINO SETUP =====
 * =========================
 * */

void setup() {
	noInterrupts(); // Disable interrupts while in setup
	Serial.begin(115200); //Initialize Serial comms for debug
	Serial.println("-----*-----");

	//----- Initialize Hardware ----
	// Sensor
	if (MAIN_DEBUG) Serial.print("Initialising Sensor...");
	init_sensor();
	if (MAIN_DEBUG) Serial.println("OK");

	//Radio
	if (MAIN_DEBUG) Serial.print("Initialising Radio...");
	init_radio();
	if (MAIN_DEBUG) Serial.println("OK");

	// Motors
	if (MAIN_DEBUG) Serial.print("Initialising Motors...");
	init_motors();
	config_motors();
	if (MAIN_DEBUG) Serial.println("OK");

	// Timer
	if (MAIN_DEBUG) Serial.print("Initialising Timer 1...");
	init_t1();
	if (MAIN_DEBUG) Serial.println("OK");

	// Mixer
	if (MAIN_DEBUG) Serial.print("Initialising Mixer...");
	config_mixer(CROSS);
	if (MAIN_DEBUG) Serial.println("OK");

	// LEDs
	if (MAIN_DEBUG) Serial.print("Initialising LEDs...");
	if(!TUNE) init_a_leds(); //If we are tunning disable Analog Pins as Output
	init_d_leds();
	if (MAIN_DEBUG) Serial.println("OK");

	if(TUNE){
		// Analog Read
		if (MAIN_DEBUG) Serial.print("Initialising Analog Read...");
		init_analog_read();
		if (MAIN_DEBUG) Serial.println("OK");
	}

	interrupts(); // Enable interrupts once setup complete
	}



// ================================================================
// ===                    MAIN PROGRAM LOOP                     ===
// ================================================================

void loop() {
	// ----- INITIALIZATION ----
	//Initialize the watchdog. Will only happen once
	if (MAIN_DEBUG) Serial.print("Initialising Watchdog...");
	init_watchdog();
	reset_watchdog();
	if (MAIN_DEBUG) Serial.println("OK");

	clear_led(GPIO0);
	clear_led(GPIO1);
	clear_led(GPIO2);
	clear_led(GPIO3);

	clear_led(LED_PIN);

	read_radio();
	read_aux1();
	delay_t1(10);
	reset_watchdog(); // Reset the watchdog

// ----- Motor Calibration -----
/*
	 * To Calibrate
	 * 1. Connect USB cable
	 * 2. Ensure Transmiter and and Rx are connected
	 * 3. Set throttle stick to max
	 * 4. Toggle AUX stick ON
	 * 5. Restart the Arduino
	 * 6. Connect the battery
	 * 7. and go through the motor beep sequecne to calibrate
 */
	if(read_aux1() == true){
		set_led(GPIO0);
		set_led(GPIO2);

		while(read_aux1() == true){
			read_radio();
			write_motor_1(read_thro());
			write_motor_2(read_thro());
			write_motor_3(read_thro());
			write_motor_4(read_thro());
			read_aux1();
			reset_watchdog(); // Reset the watchdog
		}

	}
	clear_led(GPIO0);
	clear_led(GPIO2);

	// ----- THROTTLE SAFETY -----
	// Safety: Ensure software does not start until the motors are in a safe position
	static uint8_t init_thro = 1; // Local to serve as the first reading from the radio

	while(init_thro > 0){
		set_led(LED_PIN); // Light LED to show nothing happening
		delay_t1(10); // Delay to allow the radio to be read
		read_radio();
		init_thro = read_thro(); // Store read value locally
		reset_watchdog(); // Reset the watchdog
	}


	clear_led(GPIO3);
	clear_led(GPIO2);
	clear_led(GPIO1);

	clear_led(LED_PIN); //All good to start running program turn led off

	// =====================
	// ===== MAIN LOOP =====
	// =====================
	//Create an infinite loop - enables for "void loop" initialization
	while(1) {


		// ----- Heartbeat -----
		if (task_0_count >= 200){
			task_0_count = 0;
			toggle_led(LED_PIN);
		}

		// ----- Serial -----
		// Every 100ms this function is called 10Hz
		if (task_1_count >= 100) {
			task_1_count = 0; // Reset Task Counter

			// Sensor Debug
			Serial.print("ypr:\t");
			Serial.print(angleYPR[0]);
			Serial.print("\t");
			Serial.print(angleYPR[1]);
			Serial.print("\t");
			Serial.print(angleYPR[2]);
			Serial.print("\t");

			Serial.print("Gy-R:\t");
			Serial.print(gyroYPR[2]); //Yaw
			Serial.print("\t");
			Serial.print(gyroYPR[1]); // Pitch
			Serial.print("\t");
			Serial.print(gyroYPR[0]); // Roll

			Serial.println("");

/*

			// Radio Debug
		Serial.print("Th: ");
		//Serial.print(read_raw_thro()); /// Reads the raw value from each axis
		Serial.print(read_thro());
		Serial.print("\t");

		Serial.print("Ru: ");
		//Serial.print(read_raw_rudd()); /// Reads the raw value from each axis
		Serial.print(read_rudd());
		Serial.print("\t");

		Serial.print("El: ");
		//Serial.print(read_raw_elev()); /// Reads the raw value from each axis
		Serial.print(read_elev());
		Serial.print("\t");

		Serial.print("Al: ");
		//Serial.print(read_raw_alie()); /// Reads the raw value from each axis
		Serial.print(read_alie());
		Serial.print("\t");

		Serial.print("Au: ");
		//Serial.print(read_raw_aux1()); /// Reads the raw value from each axis
		Serial.print(read_aux1());
		Serial.print("\t");

		Serial.print("Ge: ");
		//Serial.print(read_raw_gear()); /// Reads the raw value from each axis
		Serial.print(read_gear());
		Serial.print("\t");

		Serial.print("TC: ");
		//Serial.print(thro_cut_off()); /// Reads the raw value from each axis
		Serial.print(thro_cut_off());


		Serial.println("");
*/

			/*
			 //Gain Debug
			Serial.println(gain,3);
			 *
			 */
		}


		// ----- Main Control Loop -----
		// Called every 5ms. 200Hz
		else if(task_2_count >= 5) {
			task_2_count = 0; // Reset the task counter

			// ----- Sensor -----
				get_sensor();

			// ----- Radio -----
			read_radio();

			thro_demand = read_thro();
			roll_demand = read_alie();
			pitch_demand = read_elev();
			yaw_demand = read_rudd();

			if (read_aux1()){
				set_led(GPIO2);
			}
			else {
				clear_led(GPIO2);
			}


			if (read_gear()){
				set_led(GPIO1);
			}
			else {
				clear_led(GPIO1);
			}


			// PID Debug/Tuning
			ROLL_RATE_Kp = gain;

			//----- PID -----
			// Rate - Acro
			// Roll
			float P_Roll_Rate = RateRoll.p_pid(roll_demand, gyroYPR[0]); // gyroYPR - Global Variable
			float I_Roll_Rate = RateRoll.i_pid(roll_demand, gyroYPR[0]);
			float D_Roll_Rate = RateRoll.d_pid(roll_demand, gyroYPR[0]);
			float PID_Roll_Rate = (P_Roll_Rate * ROLL_RATE_Kp) + (I_Roll_Rate * ROLL_RATE_Ki) + (D_Roll_Rate * ROLL_RATE_Kd);

			// Pitch
			float P_Pitch_Rate = RatePitch.p_pid(pitch_demand,gyroYPR[1]);
			float I_Pitch_Rate = RatePitch.i_pid(pitch_demand,gyroYPR[1]);
			float D_Pitch_Rate = RatePitch.d_pid(pitch_demand,gyroYPR[1]);
			float PID_Pitch_Rate = (P_Pitch_Rate * PITCH_RATE_Kp) + (I_Pitch_Rate * PITCH_RATE_Ki) + (D_Pitch_Rate * PITCH_RATE_Kd);

			// Yaw
			float P_Yaw_Rate = RateYaw.p_pid(yaw_demand, gyroYPR[2]);
			float I_Yaw_Rate = RateYaw.i_pid(yaw_demand, gyroYPR[2]);
			float D_Yaw_Rate = RateYaw.d_pid(yaw_demand, gyroYPR[2]);
			float PID_Yaw_Rate = (P_Yaw_Rate * YAW_RATE_Kp) + (I_Yaw_Rate * YAW_RATE_Ki) + (D_Yaw_Rate * YAW_RATE_Kd);


			//Position - Stab
			// Roll
			float P_Roll_Pos = PosRoll.p_pid(0,0);
			float I_Roll_Pos = PosRoll.i_pid(0,0);
			float D_Roll_Pos = PosRoll.d_pid(0,0);
			float PID_Roll_Pos = (P_Roll_Pos * ROLL_POS_Kp) + (I_Roll_Pos * ROLL_POS_Ki) + (D_Roll_Pos * ROLL_POS_Kd);

			// Pitch
			float P_Pitch_Pos = PosPitch.p_pid(0,0);
			float I_Pitch_Pos = PosPitch.i_pid(0,0);
			float D_Pitch_Pos = PosPitch.d_pid(0,0);
			float PID_Pitch_Pos = (P_Pitch_Pos * PITCH_POS_Kp) + (I_Pitch_Pos * PITCH_POS_Ki) + (D_Pitch_Pos * PITCH_POS_Kd);

			// Yaw
			float P_Yaw_Pos = PosYaw.p_pid(0,0);
			float I_Yaw_Pos = PosYaw.i_pid(0,0);
			float D_Yaw_Pos = PosYaw.d_pid(0,0);
			float PID_Yaw_Pos = (P_Yaw_Pos * YAW_POS_Kp) + (I_Yaw_Pos * YAW_POS_Ki) + (D_Yaw_Pos * YAW_POS_Kd);

			// ----- Mixer - Motors -----
			// Throttle cut off - if enabled kill motors

			// ----- SAFETY -----
			if(thro_cut_off() == true) {

				set_led(GPIO3);

				write_motor_1(0);
				write_motor_2(0);
				write_motor_3(0);
				write_motor_4(0);

				cut_off_flag = 1; // Raise flag to say cut off occured
			}

			// No Throttle cut off - proceed as normal
			else {
				//Ensure that after cut off the throttle needs to return to 0 before starting again
				if (cut_off_flag == 1) { //has cut off occured
					read_radio();
					if (read_thro() == 0) { // has throttle zeroed
						cut_off_flag = 0;
					}
					// Throttle in an unsafe position
					else {
						set_led(GPIO3);
					}
				}

				// ----- MIXER -----
				else { //cut off flag 0 Safe to proceed
					//roll_mixer(thro, roll); //Motors 2 and 3
					//roll_mixer(thro, error); //Motors 2 and 3
					//pitch_mixer(thro, pitch); // Motors 1 and 4
					//TODO: yaw_mixer(); // Will need a compass to complete this and possibly GPS

					write_motor_1(thro_demand); // Example:  Throttle_demand + PID_Roll_Rate
					write_motor_2(thro_demand); // Throttle_demand - PID_Roll_Rate
					write_motor_3(thro_demand); // Throttle_demand + PID_Pitch_Rate
					write_motor_4(thro_demand); // Throttle_demand - PID_Pitch_Rate
				}
			}
		}


		// ----- GPIO Task -----
		else if(task_3_count >= 10) {
			task_3_count = 0; // Reset the task counter
			task_3a_count++;

			// Causes LED to Blink - From HERE
			// Sub-task at different rate to parent task.
			if(task_3a_count == 10) {
				//ON LED
				 set_led(GPIO0);
			}
			else if(task_3a_count == 20){
				//OFF LED
				 clear_led(GPIO0);
			}
			else if(task_3a_count == 30){
				//ON LED
				 set_led(GPIO0);
			}
			else if(task_3a_count == 40){
				//OFF LED
				 clear_led(GPIO0);
			}
			else if(task_3a_count == 100){
				task_3a_count = 0;
			}
			// To HERE

		}


		//----- Things to Do on Every loop cycle -----
		// Reset the watch dog timer. Needs a reset every 15ms
		reset_watchdog();

		// Compute smoothing of analog read to reduce noise
		//gain = smoothing() * 0.0009765625; // 1/1024 - To give 0-1 scale
		//gain = smoothing() * 0.00048828125; // 0.5/1024 - Scale: 0 - 0.5

		//note 920 = 4.5 v
		gain = smoothing() * 0.0005; // 1/920 - 0-1scale


	}
